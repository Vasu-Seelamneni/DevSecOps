									"text": "Is it mandatory to create public IP in Public subnet VM's or for atleast only one VM to access as jumphost?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Is it good practice to maintain global rules on NACL and specific on SG level?"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "Instead we are creating single SG and assigning it to all VM's? Just wanted to know which way is industry standard recommended way?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Isn't VPC peering is bidirectional?"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "Irrespective of requestor/requestee in VPC peering, once requested --> connected it is vise-versa communications established between peered VPC VM's?"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "We encountered the issue with .pem permission to access from North public VM --> North private VM"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "text",
									"text": "Instead of can we change the pem permissions via chmod 655 or so?"
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								},
								{
									"type": "hardBreak",
									"attrs": {
										"dir": "auto"
									}
								}
							]
						}
					]
				}
			},
			"parentId": "page:41rvNjwed2ma1TwuSuNTH",
			"index": "b5qquz",
			"typeName": "shape"
