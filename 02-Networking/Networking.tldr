			"parentId": "page:41rvNjwed2ma1TwuSuNTH",
			"index": "b2X8YU",
			"typeName": "shape"
		},
		{
			"x": -194.20064445975572,
			"y": 6727.382652610839,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:f5HcNjAfvMHzPP1IzebzD",
			"type": "text",
			"props": {
				"color": "green",
				"size": "l",
				"w": 2921.9375,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Notes:"
								}
							]
						},
						{
							"type": "bulletList",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Azure does Not allow a single Bastion to be shared across mutliple vNETS? Yes, a traditional jumpbox VM "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "can"
												},
												{
													"type": "text",
													"text": " be shared across VNets, but Bastion cannot."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Azure does NOT allow a single NAT Gateway to be shared across multiple VNets? Yes, 1-1 NAT Gateway to vNET associated SubNet"
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Can we associate the same NAT Gateway to another subnet in the same VNet? Yes, Azure supports it."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"text": "Restriction in creation of public ip's in Azure free tier, max 2 can be created. "
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
			"parentId": "page:41rvNjwed2ma1TwuSuNTH",
			"index": "b5XptM",
			"typeName": "shape"
