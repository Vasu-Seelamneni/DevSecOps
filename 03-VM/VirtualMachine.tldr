					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Create a VPC --> 2 zones --> 2public subnets 1a(10.1.1.0/24) & 1b(10.1.2.0/24)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Create 2 VMS --> 1 each in public subnet 1a & 1b --> SG with port 22 & 80 allow --> auto assign public ip --> ssh & install apache2 --> test and remove public ips"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Create ALB --> assign target group of vms after creation --> test the DNS url and it should work access both apps installe din 1a & 1b"
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "anA7U",
			"typeName": "shape"
		},
