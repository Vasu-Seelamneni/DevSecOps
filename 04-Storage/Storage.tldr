													],
													"text": "Virtual Machine"
												},
												{
													"type": "text",
													"text": " can now look across the local network and talk to the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "PAAS"
												},
												{
													"type": "text",
