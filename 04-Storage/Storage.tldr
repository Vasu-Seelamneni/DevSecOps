											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Key limitation:"
												},
												{
													"type": "text",
													"text": " Cannot store actual files (like images or PDFs)—only text, numbers, and dates."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "🎟️ 4. Queue Storage (The Waiting Line)"
								}
							]
						},
						{
							"type": "bulletList",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "What it is:"
												},
												{
													"type": "text",
													"text": " A temporary holding zone for small text messages passed between different parts of a software application."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Analogy:"
												},
												{
													"type": "text",
													"text": " A ticket dispenser at the deli counter. First in, first out. It keeps things organized when the store gets busy."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Best for:"
												},
												{
													"type": "text",
													"text": " Decoupling apps (e.g., App A takes your order, puts a message in the queue, and App B processes the payment whenever it is ready)."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Key limitation:"
												},
												{
													"type": "text",
													"text": " Messages are very small and disappear as soon as they are processed. It is not meant for long-term storage."
												}
											]
										}
									]
								}
							]
						}
					]
				}
			},
