												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Key limitation:"
												},
												{
													"type": "text",
													"text": " Does not scale infinitely like a bucket; performance drops if you dump millions of files into one folder."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
