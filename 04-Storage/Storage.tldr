											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "The Edit / Overwrite:"
												},
												{
													"type": "text",
													"text": " If you upload a modified version of "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "report.txt"
												},
												{
													"type": "text",
													"text": " with the exact same name, the cloud provider doesn't erase the old one. Instead, it freezes the old file, stamps it with a read-only "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Version ID (Timestamp)"
												},
												{
													"type": "text",
													"text": ", and marks your newly uploaded file as the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "Current Version"
												},
												{
													"type": "text",
													"text": ". ["
