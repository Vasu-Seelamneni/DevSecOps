												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "What it is:"
												},
												{
													"type": "text",
													"text": " Traditional file storage with real folders and subfolders that multiple computers can connect to over a network."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
