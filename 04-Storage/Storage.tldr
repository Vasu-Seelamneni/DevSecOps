											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "The \"Current\" File:"
												},
												{
													"type": "text",
													"text": " When you upload "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "report.txt"
												},
												{
													"type": "text",
													"text": ", it becomes the "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "Current Version"
												},
												{
													"type": "text",
													"text": ". ["
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "link",
															"attrs": {
																"href": "https://oneuptime.com/blog/post/2026-02-16-how-to-enable-and-manage-blob-versioning-in-azure-storage/view",
																"target": "_blank",
																"rel": "noopener noreferrer nofollow",
																"class": null
															}
														}
													],
													"text": "1"
												},
												{
													"type": "text",
