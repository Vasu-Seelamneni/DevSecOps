													"text": "What it is:"
												},
												{
													"type": "text",
													"text": " A flat, infinite storage space for raw files. No real folders exist; everything gets a unique web link (URL)."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Analogy:"
												},
												{
													"type": "text",
													"text": " Dumping thousands of toys into one giant box. To look at a toy, you have to grab the whole thing out."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Best for:"
												},
												{
													"type": "text",
													"text": " Raw data files, video/audio streaming, backups, and app images."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
