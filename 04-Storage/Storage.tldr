														{
															"type": "bold"
														}
													],
													"text": "How it works:"
												},
												{
													"type": "text",
													"text": " Azure takes a private network card (NIC) with an internal IP address (e.g., "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "10.0.0.5"
												},
												{
													"type": "text",
													"text": ") from your "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "vnet"
												},
												{
													"type": "text",
													"text": " and attaches it directly to that "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "PAAS"
												},
												{
													"type": "text",
													"text": " resource."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "The Result:"
												},
												{
													"type": "text",
													"text": " The "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
