												},
												{
													"type": "text",
													"marks": [
														{
															"type": "italic"
														}
													],
													"text": "Current Version"
												},
												{
													"type": "text",
													"text": " pointer is removed. All your previous historical versions remain saved safely in the background. ["
												},
												{
