														}
													],
													"text": "The Tech:"
												},
												{
													"type": "text",
													"text": " Microchips and flash memory with zero moving parts."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
