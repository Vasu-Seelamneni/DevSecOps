												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Analogy:"
												},
												{
													"type": "text",
													"text": " A giant Excel sheet with rows of user settings or device logs."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
