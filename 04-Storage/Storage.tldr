														}
													],
													"text": "Best Use:"
												},
												{
													"type": "text",
													"text": " Active databases, operating systems, and apps that need instant speed (Hot Data)."
												}
											]
										}
									]
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
