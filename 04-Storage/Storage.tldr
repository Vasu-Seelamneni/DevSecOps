												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Analogy:"
												},
												{
													"type": "text",
													"text": " A shared corporate network drive ("
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "Z:\\Drive"
												},
												{
													"type": "text",
													"text": ") where team members open and edit files."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
												"dir": "auto"
											},
											"content": [
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Best for:"
												},
												{
													"type": "text",
													"text": " Migrating old software to the cloud, sharing office documents (Word, Excel) among a team, and live file editing."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"attrs": {
										"dir": "auto"
									},
									"content": [
										{
											"type": "paragraph",
											"attrs": {
