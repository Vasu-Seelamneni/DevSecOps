												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Best for:"
												},
												{
													"type": "text",
													"text": " Quick lookups (e.g., finding a user's phone number by their ID) and storing customer profiles or sensor logs."
												}
