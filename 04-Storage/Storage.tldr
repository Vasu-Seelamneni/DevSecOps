														{
															"type": "bold"
														}
													],
													"text": "The Performance:"
												},
												{
													"type": "text",
													"text": " "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "Low latency"
												},
												{
													"type": "text",
													"text": " (instant access) and "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "high IOPS"
												},
												{
													"type": "text",
													"text": " (can read thousands of locations at once). It is more expensive."
