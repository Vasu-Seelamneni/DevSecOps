												{
													"type": "text",
													"marks": [
														{
															"type": "bold"
														}
													],
													"text": "The Deletion:"
												},
												{
													"type": "text",
													"text": " If someone hits delete on "
												},
												{
													"type": "text",
													"marks": [
														{
															"type": "code"
														}
													],
													"text": "report.txt"
												},
												{
													"type": "text",
