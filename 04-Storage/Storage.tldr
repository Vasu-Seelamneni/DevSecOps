																{
																	"type": "text",
																	"marks": [
																		{
																			"type": "bold"
																		}
																	],
																	"text": "GRS / GZRS:"
																},
																{
																	"type": "text",
																	"text": " Choose this for disaster recovery. It saves your data locally, then "
