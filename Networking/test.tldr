			"opacity": 1,
			"meta": {},
			"id": "shape:dB_sra_jpwW-TH4zCh25d",
			"type": "text",
			"props": {
				"color": "black",
				"size": "l",
				"w": 3634.15625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Why we have created independently public IP and associated to the BEVM? Is it just to show we have another way to do?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Why the IP address is different when I use the ipconfig and "
								},
								{
									"type": "text",
									"marks": [
										{
											"type": "link",
											"attrs": {
												"href": "http://whatismyipaddress.com",
												"target": "_blank",
												"rel": "noopener noreferrer nofollow",
												"class": null
											}
										}
									],
									"text": "whatismyipaddress.com"
								},
								{
									"type": "text",
									"text": "?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> What is the need of providing public addreess though it is restricted on port 22. Is it because some other ports can be accessed based on requirements?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> I think I have got answered from Satya org configuration, their DB's can be accessed for metadata directly where as sensitive data has to be accessed via Application server"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Why we do not use https because of buying certificates and it is complex process --> I need to understand more on this"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Why the priority starting from 100 and not from o. By design Azure has given flexibility to start from 100 it is because azure holds those 100."
								}
							]
						}
					]
				}
			},
