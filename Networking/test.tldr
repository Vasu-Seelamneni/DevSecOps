		},
		{
			"x": -979.8195918223862,
			"y": 3983.4998885547793,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:rRp8zwTkyihRaYREiNHQ4",
			"type": "text",
			"props": {
				"color": "black",
				"size": "l",
				"w": 1847.59375,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "5 Questions:"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "1. is their difference between creating bastion independently and through vNET?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "2. We have 2 hosts created in bastion, how the second host is being used, when & where in azure?"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "3. Overall, Azure Bastion is used to prevent direct access to VMs from the public internet."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "4. Overall ASG is used to provide access to mix of machines from different SN's (Yet to practice)"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "4. Does these NSG/ASG are chargeable?"
								}
							]
						}
					]
				}
			},
			"parentId": "page:5Au72Z8L5FEUuNFzU-Dua",
			"index": "b4vamI",
			"typeName": "shape"
