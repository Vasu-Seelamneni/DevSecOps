			"parentId": "page:page",
			"index": "b9XeoI",
			"typeName": "shape"
		},
		{
			"x": -985.8597585310213,
			"y": 4362.075412949365,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:z86zVPSnhthmyacIQ7U2k",
			"type": "text",
			"props": {
				"color": "black",
				"size": "l",
				"w": 2422.90625,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"content": [
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "devopsuser@MFVM:~$ How to establish peering between multiple vNETS?^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "devopsuser@MFVM:~$ What is the difference between Remote & Local virtual network peering?^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "devopsuser@MFVM:~$ client_loop: send disconnect: Connection reset\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> How to establish peering between multiple vNETS? Using hub vNET to Spokes?^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Is it same like 1publisher & multiple consumers? Can we see an example?^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> Is it possible to grant NAT gateway at VM level? Understand that we attach on subnet level^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> In realtime howmany subnets we will have? Generally same NAT Gateways attached to the subnets? or in what requirement basis we create a new NAT Gateway in vNET?^C\r"
								}
							]
						},
						{
							"type": "paragraph",
							"content": [
								{
									"type": "text",
									"text": "PS C:\\Users\\vasu_> We can restrict internet via service tag on a particular VM in the NSG rules.^C"
								}
							]
						}
					]
				}
			},
			"parentId": "page:5Au72Z8L5FEUuNFzU-Dua",
			"index": "b4wGnE",
			"typeName": "shape"
		},
